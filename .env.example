# Copier vers .env et remplir avec vos valeurs réelles
# cp .env.example .env

APP_NAME=fonaqo
DEBUG=True

# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-new-secret-key

DATABASE_URL=postgis://fonaqo:change-me@localhost:5432/fonaqo_db

# Clé Mistral — https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=
SMS_API_KEY=

# FeexPay
FEEXPAY_API_KEY=your_api_key_here
FEEXPAY_API_TOKEN=your_api_token_here
FEEXPAY_SHOP_ID=your_shop_id_here
FEEXPAY_WEBHOOK_SECRET=your_webhook_secret_here
FEEXPAY_MODE=SANDBOX
FEEXPAY_CALLBACK_BASE_URL=http://localhost:8000

# Sécurité uploads
UPLOAD_MAX_SIZE_MB=10

# CORS / hosts
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT dev — en prod : JWT_ACCESS_MINUTES=60, JWT_REFRESH_DAYS=7
JWT_ACCESS_MINUTES=43200
JWT_REFRESH_DAYS=365
JWT_BLACKLIST=False

FIREBASE_KEY_PATH=/app/firebase-auth.json
MAX_EXPORT_ROWS=1000
DATA_UPLOAD_MAX_MB=10

# Alertes staff (rapprochement ledger, litiges…) — CSV, ex: admin@fonaco.com,cto@fonaco.com
ADMIN_ALERT_EMAILS=
